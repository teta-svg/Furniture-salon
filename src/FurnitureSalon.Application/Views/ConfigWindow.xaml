<Window x:Class="FurnitureSalon.Application.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="900" Height="780" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterOwner" Style="{StaticResource GreenWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                <TextBlock Text="{Binding Subtitle}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Text="Клиент" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="Тип клиента" Margin="0,12,0,5" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding SelectedClientType}" IsEnabled="{Binding IsClientTypeEditable}"/>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsPhysicalClient, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Фамилия" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Имя" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Отчество" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Patronymic, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Телефон" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsLegalClient, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                    <TextBlock Text="Название компании" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="ИНН" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="КПП" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Kpp, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Фамилия контактного лица" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactSurname, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Имя контактного лица" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Отчество контактного лица" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ContactPatronymic, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Телефон компании" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Text="Адрес доставки" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="Город" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeliveryCity, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Улица" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeliveryStreet, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Дом" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeliveryBuilding, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Квартира / офис" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeliveryApartment, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Позиции заказа" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Соберите индивидуальную конфигурацию из справочников." Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Модель" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Категория ткани" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FabricCategories}" SelectedItem="{Binding SelectedFabric}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Механизм трансформации" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Mechanisms}" SelectedItem="{Binding SelectedMechanism}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Цвет" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Размеры, см (Д × Ш × В)" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                        <TextBox Grid.Column="2" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                        <TextBox Grid.Column="4" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Модули хранения (необязательно)" Margin="0,0,0,4"/>
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Background="White">
                                        <ScrollViewer Height="76" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding StorageModules}" Margin="8,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Количество" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Плановая готовность" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding PlannedDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <Button Content="Отменить правку" Style="{StaticResource GhostButton}" Command="{Binding CancelItemEditCommand}" Visibility="{Binding IsEditingItem, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="{Binding AddItemButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding AddItemCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItemRow, Mode=TwoWay}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="130" MaxHeight="230" Margin="0,14,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Изделие" Binding="{Binding DisplayName}" Width="3*"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Готовность" Binding="{Binding PlannedReadyDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" Width="120"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding CurrentStatus}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Изменить позицию" Style="{StaticResource GhostButton}" Command="{Binding EditItemCommand}"/>
                            <Button Content="Удалить позицию" Style="{StaticResource GhostButton}" Command="{Binding RemoveItemCommand}"/>
                        </StackPanel>
                        <Border Background="#F7FAF7" CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Подробный расчёт стоимости одной конфигурации" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Базовая стоимость модели"/>
                                    <TextBlock Text="{Binding ModelPriceText}" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Text="Наценка за категорию ткани"/>
                                    <TextBlock Text="{Binding FabricPriceText}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Text="Наценка за механизм"/>
                                    <TextBlock Text="{Binding MechanismPriceText}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Grid.Row="3" Text="Модули хранения"/>
                                    <TextBlock Text="{Binding StoragePriceText}" Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Grid.Row="4" Text="Стоимость конфигурации" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding ConfigurationTotalText}" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="5" Text="С учётом количества" FontWeight="Bold" FontSize="16" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding ConfigurationQuantityTotalText}" Grid.Row="5" Grid.Column="1" FontWeight="Bold" FontSize="16" Margin="0,6,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,14,0,0" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="24,14" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="{Binding CloseButtonText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Content="Сохранить заказ" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>