<Window x:Class="FurnitureSalon.Applications.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:viewmodels="clr-namespace:FurnitureSalon.Application.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Заказы"
        Width="1100" Height="680"
        MinWidth="900" MinHeight="520"
        Style="{StaticResource GreenWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38"
                            CornerRadius="8"
                            Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="М"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="МЕБЕЛЬ-ПРО"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="Управление заказами"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <StackPanel VerticalAlignment="Center"               
                                HorizontalAlignment="Right"                                
                                Margin="0,0,12,0">
                        <TextBlock x:Name="EmployeeNameText"
                                   Text="Иванов И. И."
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="EmployeeRoleText"
                                   Text="Администратор"
                                   FontSize="12"                 
                                   Foreground="{StaticResource MutedBrush}"                   
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#C8E6C9">
                        <TextBlock x:Name="EmployeeInitialText"                   
                                   Text="И"                   
                                   FontWeight="SemiBold"                  
                                   FontSize="15"                   
                                   Foreground="{StaticResource PrimaryDarkBrush}"                  
                                   HorizontalAlignment="Center"                   
                                   VerticalAlignment="Center"/>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Заказы"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBlock Text="Управление клиентскими заказами и их статусами"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="＋  Создать заказ"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="16"
                    Margin="0,18,0,14">

                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="220">
                        <TextBlock Text="Статус" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Width="320" Margin="18,0,0,0">
                        <TextBlock Text="Поиск по номеру или ФИО клиента" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Введите номер заказа или фамилию"/>
                    </StackPanel>

                    <Button Content="Найти" Style="{StaticResource PrimaryButton}" 
                            Margin="18,10,0, 10"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="8">

                <ListBox x:Name="OrdersList" ItemsSource="{Binding Orders}" Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="16">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8F5E9"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IdOrder, StringFormat='№ {0}'}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ClientType}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Дата создания" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CreationDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#F7FAF7" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding OrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0} шт.'}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PlannedReadyDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding CurrentStatus}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{Binding OrderItems.Count, StringFormat='Позиций: {0}'}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Итого: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} ₽'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="HintText"
                           Text="Выберите заказ в таблице, чтобы выполнить действие"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Открыть заказ"
                            Style="{StaticResource GhostButton}"/>

                    <Button Content="Выставить счёт"
                            Style="{StaticResource GhostButton}"/>

                    <Button Content="Принять платёж"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button Content="Изменить заказ"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>