<Window x:Class="FurnitureSalon.Application.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureSalon.Application.Views" 
        xmlns:viewmodels="clr-namespace:FurnitureSalon.Application.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        mc:Ignorable="d"
        Title="Вход в систему"
        Width="440"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MainFont}"
        FontSize="14">

    <Grid Margin="32">
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                Padding="32">

            <StackPanel>
                <Border Background="{StaticResource PrimaryBrush}"
                        Padding="22,12"
                        HorizontalAlignment="Center">
                    <TextBlock Text="МЕБЕЛЬ-ПРО"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Учёт заказов салона мягкой мебели"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0,12,0,28"/>

                <TextBlock Text="Логин"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Login}"
                         Padding="10,8"
                         BorderBrush="{StaticResource BorderBrushSoft}"
                         BorderThickness="1"
                         ToolTip="Логин выдаёт администратор"/>

                <TextBlock Text="Пароль"
                           FontWeight="SemiBold"
                           Margin="0,16,0,5"/>

                <PasswordBox x:Name="PasswordBox"
                             Padding="10,8"
                             BorderBrush="{StaticResource BorderBrushSoft}"
                             BorderThickness="1"/>

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>

                <Button Content="Войти"
                        Height="40"
                        Margin="0,28,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Command="{Binding LoginClickCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>